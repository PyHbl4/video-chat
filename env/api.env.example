APP_ENV=development
DATABASE_URL=postgresql+psycopg://video:video@db:5432/videochat
REDIS_URL=redis://redis:6379/0

# Auth
SESSION_SECRET=replace_me_session_secret
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
CSRF_HEADER_NAME=X-CSRF-Token
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
JWT_SECRET=replace_me_jwt_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Admin / RBAC
ADMIN_SUPERUSERS=admin@example.com
ADMIN_PAGE_SIZE_DEFAULT=25
ADMIN_PAGE_SIZE_MAX=100

# TURN (dev only; prod будет через TLS и краткоживущие креды)
TURN_REALM=video.local
TURN_STATIC_USER=dev
TURN_STATIC_PASSWORD=dev
TURN_TTL_SECONDS=90
