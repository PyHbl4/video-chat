{
  "name": "@video-chat/web-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./auth/*": {
      "import": "./src/auth/*",
      "types": "./src/auth/*"
    },
    "./session/*": {
      "import": "./src/session/*",
      "types": "./src/session/*"
    },
    "./api/*": {
      "import": "./src/api/*",
      "types": "./src/api/*"
    },
    "./server/*": {
      "import": "./src/server/*",
      "types": "./src/server/*"
    },
    "./components/*": {
      "import": "./src/components/*",
      "types": "./src/components/*"
    },
    "./hooks/*": {
      "import": "./src/hooks/*",
      "types": "./src/hooks/*"
    },
    "./env": {
      "import": "./src/env.ts",
      "types": "./src/env.ts"
    }
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^15.1.0 || ^15.2.0 || ^15.3.0 || ^15.4.0 || ^15.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@video-chat/contracts": "workspace:*"
  }
}
