{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "next"
    ],
    "lib": ["dom", "dom.iterable", "esnext"],
    "paths": {
      "@video-chat/contracts": ["../contracts/src/index.ts"],
      "@video-chat/contracts/*": ["../contracts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules"]
}
