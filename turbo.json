{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "cache": true, "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "build/**"] },
    "lint": { "cache": true },
    "typecheck": { "cache": true },
    "format": { "cache": false }
  }
}
